{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm build"
  },
  "deploy": {
    "startCommand": "pnpm drizzle-kit migrate && pnpm start",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
